<div class="rounded-3 p-4 mb-4 text-white d-flex justify-content-between align-items-center"
     style="background: linear-gradient(135deg, #FF6B35, #ff8c5f);">
    <div>
        <div class="small mb-1 opacity-75">إجمالي أرباحك</div>
        <div class="fw-black mb-2" style="font-size:2.2rem;">
            @Model.Balance.ToString("F0") جنيه
        </div>
        <div class="small opacity-75">متاح للسحب الآن</div>
    </div>
    <a asp-action="Earnings" class="btn fw-semibold px-4 py-2"
       style="background:rgba(255,255,255,0.2); color:white;">
        سحب الأرباح
    </a>
</div>