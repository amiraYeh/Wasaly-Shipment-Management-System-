@model Wasaly.BLL.ViewModels.CourierShipmentVM
@using Wasaly.DAL.Enums

<div class="bg-white rounded-3 p-4 shadow-sm mb-4">
    <h6 class="fw-bold mb-4">شحنتك الحالية #@Model.TrackingNumber</h6>

    @await Html.PartialAsync("_ShipmentDetails", Model)

    <div>
        <div class="d-flex flex-column gap-3 mb-4">

            <div class="d-flex align-items-start gap-3 p-3 rounded-3"
                 style="background:#f0fdf4; border:1px solid #bbf7d0;">
                <span style="font-size:1.5rem;">🟢</span>
                <div class="flex-grow-1">
                    <div class="small text-success mb-1">نقطة الاستلام</div>
                    <div class="fw-semibold">@Model.PickupAddress</div>
                    @if (Model.ShipmentStatus != ShipmentStatus.Accepted)
                    {
                        <div class="small text-success mt-1">✓ تم الاستلام</div>
                    }
                </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-3 rounded-3"
                 style="background:#fff5f5; border:1px solid #fecaca;">
                <span style="font-size:1.5rem;">🔴</span>
                <div class="flex-grow-1">
                    <div class="small text-danger mb-1">نقطة التسليم</div>
                    <div class="fw-semibold">@Model.DropAddress</div>
                    <a href="#" class="small text-primary mt-1 d-block">📍 عرض على الخريطة</a>
                </div>
            </div>

        </div>

        @await Html.PartialAsync("_TrackingTimeline", Model.TrackingHistory)

        <div class="mt-4">
            @if (Model.ShipmentStatus == ShipmentStatus.Accepted)
            {
                <form asp-action="PickupShipment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="shipmentId" value="@Model.ShipmentId" />
                    <button class="btn w-100 fw-bold py-2 text-white"
                            style="background:#2ECC71;">
                        تأكيد الاستلام من التاجر
                    </button>
                </form>
            }
            @if (Model.ShipmentStatus == ShipmentStatus.PickedUp)
            {
                <form asp-action="GenerateOtp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="shipmentId" value="@Model.ShipmentId" />
                    <button class="btn btn-orange text-white w-100 fw-bold py-2">
                        وصلت للعميل - طلب OTP
                    </button>
                </form>
            }
            @if (Model.ShipmentStatus == ShipmentStatus.Delivered)
            {
                <div class="text-center py-2">
                    <span class="badge bg-success rounded-pill px-4 py-2 fs-6">
                        ✓ تم التسليم بنجاح
                    </span>
                </div>
            }

    </div>
    
    </div>

</div>

