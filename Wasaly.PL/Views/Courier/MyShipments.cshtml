@model List<Wasaly.BLL.ViewModels.CourierShipmentVM>
@using Wasaly.DAL.Enums
@{
    ViewData["Title"] = "شحناتي الحالية";
    Layout = "~/Views/Shared/_DashBordLayout.cshtml";
}

@if (!Model.Any())
{
    <div class="bg-white rounded-3 p-5 text-center shadow-sm">
        <div style="font-size:4rem;">📭</div>
        <h5 class="fw-bold mt-3 mb-2">لا توجد شحنات حالية</h5>
        <a asp-action="AvailableShipments" class="btn btn-orange text-white mt-2">
            ابحث عن شحنات
        </a>
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_CurrentShipmentCard", item)
        }
    </div>
} 

@section Scripts
{
    <script>
    function startSendingLocation() 
    {
        if (!navigator.geolocation) 
        {
            alert("المتصفح لا يدعم GPS");
            return;
        }

    // watchPosition = بيتابع الموقع باستمرار مع تحرك المندوب
    navigator.geolocation.watchPosition(
    async (position) => {
    const lat = position.coords.latitude;
    const lng = position.coords.longitude;

    // ✅ بيبعت الموقع الحقيقي للـ Backend
    const form = new FormData();
    form.append("shipmentId", "@Model[0].ShipmentId");
    form.append("lat", lat);
    form.append("lng", lng);

    await fetch('/Shipment/UpdateLocation', {
    method: 'POST',
    body  : form
    });

    document.getElementById("status-message").innerText =
    📍 موقعك: ${lat.toFixed(4)}, ${lng.toFixed(4)};
    },
    (error) => {
    alert("تعذر الحصول على الموقع");
    },
    {
    enableHighAccuracy: true,  // ✅ دقة عالية
    maximumAge        : 0,     // ✅ موقع جديد دايما
    timeout           : 5000
    }
    );
    }

    // ابدأ لما الصفحة تفتح
    startSendingLocation();
 </script> 
}
