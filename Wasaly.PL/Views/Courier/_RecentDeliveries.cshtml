@model Wasaly.BLL.ViewModels.CourierDashboardVM

<div class="bg-white rounded-3 p-4 shadow-sm">
    <h6 class="fw-bold mb-4">آخر التوصيلات</h6>

    @if (!Model.RecentShipments.Any())
    {
        <div class="text-center py-4">
            <div style="font-size:3rem;">📭</div>
            <p class="text-muted mt-2">لا توجد توصيلات مكتملة بعد</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model.RecentShipments)
            {
                <div class="d-flex align-items-center justify-content-between p-3 rounded-3"
                     style="background:#F5F5F5;">
                    <div class="d-flex align-items-center gap-3">
                        <span style="font-size:1.8rem;">✅</span>
                        <div>
                            <div class="fw-semibold">#@item.TrackingNumber</div>
                            <div class="text-muted small">@item.DropAddress</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold" style="color:#2ECC71;">
                            +@item.Price.ToString("F0") ج
                        </div>
                        <div class="text-muted" style="font-size:.75rem;">مكتملة</div>
                    </div>
                </div>
            }
        </div>
    }
</div>