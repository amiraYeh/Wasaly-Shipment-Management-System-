@model Wasaly.BLL.ViewModels.CourierDashboardVM
@{
    ViewData["Title"] = "الرئيسية";
    Layout = "~/Views/Shared/_DashBordLayout.cshtml";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">مرحباً، @Model.CourierName 👋</h4>
    <p class="text-muted small mb-0">إليك ملخص أدائك اليوم</p>
</div>

@await Html.PartialAsync("_EarningsCard", Model)

@await Html.PartialAsync("_DashboardStats", Model)

@await Html.PartialAsync("_QuickActions")

@await Html.PartialAsync("_RecentDeliveries", Model)