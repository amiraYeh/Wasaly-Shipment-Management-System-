@model Wasaly.BLL.ViewModels.CourierShipmentVM

<div class="stat-card mt-3">
    <h6 class="fw-bold mb-3">
        <i class="bi bi-info-circle text-orange me-2"></i>تفاصيل الشحنة
    </h6>
    <div class="row g-3">
        <div class="col-6">
            <div class="text-muted small mb-1">
                <i class="bi bi-geo-alt text-orange me-1"></i> من
            </div>
            <div class="fw-semibold small">@Model.PickupAddress</div>
        </div>
        <div class="col-6">
            <div class="text-muted small mb-1">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> إلى
            </div>
            <div class="fw-semibold small">@Model.DropAddress</div>
        </div>
        <div class="col-6">
            <div class="text-muted small mb-1">
                <i class="bi bi-box-seam text-orange me-1"></i> الوزن
            </div>
            <div class="fw-semibold">@Model.Weight كجم</div>
        </div>
        <div class="col-6">
            <div class="text-muted small mb-1">
                <i class="bi bi-wallet2 text-orange me-1"></i> الأجر
            </div>
            <div class="fw-semibold text-orange">@Model.Price.ToString("F0") جنيه</div>
        </div>
    </div>
</div>
