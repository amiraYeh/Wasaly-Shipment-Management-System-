@model Wasaly.BLL.ViewModels.VerifyOtpVM

<div class="text-center p-4 rounded-3 bg-light">

    <div class="rounded-circle bg-orange d-inline-flex align-items-center justify-content-center mb-3"
         style="width:64px;height:64px;">
        <i class="bi bi-shield-lock-fill text-white fs-3"></i>
    </div>

    <h6 class="fw-bold mb-1">أدخل كود التسليم</h6>
    <p class="text-muted small mb-4">اطلب الكود من العميل لتأكيد التسليم</p>

    <form asp-action="VerifyOtp" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ShipmentId" />

        <div class="d-flex justify-content-center gap-2 mb-4" id="otpBoxes">
            @for (int i = 0; i < 6; i++)
            {
                <input type="text"
                       class="otp-input"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]" />
            }
        </div>

        <input type="hidden" asp-for="OtpCode" id="otpHidden" />
        <span asp-validation-for="OtpCode" class="text-danger small d-block mb-3"></span>

        <button type="submit" class="btn btn-orange text-white w-100 fw-bold py-2" >
            <i class="bi bi-check-circle me-1"></i> تأكيد التسليم
        </button>
    </form>
</div>
