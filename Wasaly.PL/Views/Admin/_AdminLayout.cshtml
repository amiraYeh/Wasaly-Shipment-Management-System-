<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - وصلني</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">

    <!-- ربط ملف الـ CSS بتاعك -->
    <link rel="stylesheet" href="~/css/admin-style.css">

    <!-- Cairo Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="dashboard-wrapper">
        <!-- Sidebar باستخدام الـ Classes بتاعتك -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="logo-icon">📦</span>
                    <span class="logo-text">وصلني</span>
                </div>
            </div>

            <div class="sidebar-menu">
                <!-- استخدام الـ sidebar-item من الـ CSS بتاعك -->
                <a asp-controller="Admin" asp-action="Index"
                   class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                    <span>🏠</span> لوحة التحكم
                </a>

                <a asp-controller="Admin" asp-action="Couriers" class="sidebar-item">
                    <span>🚴</span> إدارة المناديب
                </a>

                <a asp-controller="Admin" asp-action="VerificationRequests" class="sidebar-item d-flex justify-content-between align-items-center w-100">
                    <div><span>📋</span> طلبات التوثيق</div>
                    <span class="badge badge-pending">5</span>
                </a>

                <a asp-controller="Admin" asp-action="Merchants" class="sidebar-item">
                    <span>🏪</span> إدارة التجار
                </a>

                <a asp-controller="Admin" asp-action="Shipments" class="sidebar-item">
                    <span>📦</span> إدارة الشحنات
                </a>
            </div>

            <div class="p-3 border-top border-white-10">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-danger w-100 border-0 text-white" style="background: rgba(231, 76, 60, 0.1);">
                        تسجيل الخروج
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Top Navbar باستخدام الـ Classes بتاعتك -->
            <nav class="top-navbar d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0">@ViewData["Title"]</h4>

                <div class="d-flex align-items-center gap-4">
                    <div class="position-relative">
                        <span class="fs-4">🔔</span>
                        <span class="position-absolute top-0 start-0 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold">مرحباً، الأدمن</span>
                        <div class="avatar-circle bg-orange d-flex align-items-center justify-content-center text-white">👤</div>
                    </div>
                </div>
            </nav>

            <!-- Content Area -->
            <div class="content-area">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>