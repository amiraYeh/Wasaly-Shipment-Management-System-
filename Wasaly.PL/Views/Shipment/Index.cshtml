@using Wasaly.BLL.ViewModels
@using Wasaly.DAL.Enums
@model List<ShipmentVM>

@{
    Layout = "_DashBordLayout";
    ViewData["Title"] = "Shipments";
}
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .star {
            font-size: 22px;
            color: #fbbf24;
            line-height: 1;
            filter: drop-shadow(0 1px 2px rgba(251,191,36,0.4));
        }

    </style>
</head>


@* <div class="Container"> *@

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model[0].TrackingNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].CourierAssignmentName) 
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].Status)
            </th>
             <th>
                @Html.DisplayNameFor(model => model[0].CourierAssignmentRate)
            </th> 
            <th>
                @Html.DisplayNameFor(model => model[0].Price)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @item.TrackingNumber
            </td>
            <td>
                    @item.CourierAssignmentName
            </td>
            <td>
                    @item.Status
            </td>
            <td>
                    @for (int i = 0; i < item.CourierAssignmentRate;i++)
                    {
                        <span class="star">★</span>
                    }
                </td>
            <td>
                @item.Price ج.م
            </td>
		    <td>
                <button class="btn" style="background-color: #FF6B35;">
                    <a asp-action="Track" asp-controller="Shipment" asp-route-id="@item.Id" style="color:white; text-decoration-line:none"> تتبع </a>
                </button> 
             </td>
        </tr>
}
    </tbody>
</table>
@* </div> *@
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>

    </script>

}