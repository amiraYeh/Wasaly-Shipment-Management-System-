@using Wasaly.BLL.ViewModels
@model AddShipmentVM

@{
    Layout = "_DashBordLayout";
    ViewData["Title"] = "شحنة جديدة";
}

<section class="max-w-4xl mx-auto py-3 bg-white rounded-3" id="merchant-shipment">
    <div class="container text-black px-4">

        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
            <h3 class="fw-bold text-dark m-0">إضافة شحنة جديدة</h3>
            <span class="text-muted small">يرجى ملء تفاصيل الشحنة أدناه</span>
        </div>

        <form asp-action="Add" method="post" class="needs-validation">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PickupLocation" class="form-label fw-semibold text-secondary mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-map-pin"></i></span>
                            <input type="text" id="pickup-input" class="form-control border-start-0 ps-0" placeholder="ابحث عن مكان الاستلام..." autocomplete="off" />
                            <button type="button" id="btn-detect-pickup" class="btn btn-light border" title="تحديد موقعي الحالي">
                                <i class="fa-solid fa-location-crosshairs text-primary"></i>
                            </button>
                        </div>

                        <input type="hidden" asp-for="PickupLocation.Address" id="pickup-fulladdress" />
                        <input type="hidden" asp-for="PickupLocation.Latitude" id="pickup-lat" />
                        <input type="hidden" asp-for="PickupLocation.Longitude" id="pickup-lng" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DropLocation" class="form-label fw-semibold text-secondary mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-location-dot"></i></span>
                            <input type="text" id="delivery-input" class="form-control border-start-0 ps-0" placeholder="ابحث عن مكان التوصيل..." autocomplete="off" />
                            <button type="button" id="btn-detect-delivery" class="btn btn-light border" title="تحديد موقعي الحالي">
                                <i class="fa-solid fa-location-crosshairs text-primary"></i>
                            </button>
                        </div>

                        <input type="hidden" asp-for="DropLocation.Address" id="delivery-fulladdress" />
                        <input type="hidden" asp-for="DropLocation.Latitude" id="delivery-lat" />
                        <input type="hidden" asp-for="DropLocation.Longitude" id="delivery-lng" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RecipientName" class="form-label fw-semibold text-secondary mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="fa-regular fa-user"></i></span>
                            <input asp-for="RecipientName" class="form-control border-start-0 ps-0" placeholder="اسم الشخص المستلم كامل" />
                        </div>
                        <span asp-validation-for="RecipientName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RecipientEmail" class="form-label fw-semibold text-secondary mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="fa-regular fa-envelope"></i></span>
                            <input asp-for="RecipientEmail" class="form-control border-start-0 ps-0" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="RecipientEmail" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DeliveredAt" class="form-label fw-semibold text-secondary mb-2"></label>
                        <input asp-for="DeliveredAt" class="form-control" />
                        <span asp-validation-for="DeliveredAt" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Weight" class="form-label fw-semibold text-secondary mb-2"></label>
                        <div class="input-group">
                            <input asp-for="Weight" class="form-control" placeholder="0.0" />
                            <span class="input-group-text bg-light text-muted">كجم</span>
                        </div>
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-group">
                        <label asp-for="Description" class="form-label fw-semibold text-secondary mb-2"></label>
                        <input asp-for="Description" class="form-control" placeholder="تفاصيل إضافية أو وصف محتويات الشحنة..." />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <button type="reset" class="btn btn-light border px-4 fw-medium text-secondary">إلغاء</button>
                <button type="submit" class="btn btn-primary px-5 fw-medium">حفظ الشحنة</button>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function initMap() {

            // ========== HELPER: Extract address parts ==========
            function getAddressComponent(components, type) {
                const match = components.find(c => c.types.includes(type));
                return match ? match.long_name : "";
            }

            // ========== SETUP AUTOCOMPLETE ==========
            function setupAutocomplete(inputId, fieldIds) {
                const input = document.getElementById(inputId);

                const autocomplete = new google.maps.places.Autocomplete(input, {
                    componentRestrictions: { country: "eg" },
                    fields: ["formatted_address", "geometry", "address_components", "name"]
                });

                autocomplete.addListener("place_changed", () => {
                    const place = autocomplete.getPlace();

                    if (!place.geometry) {
                        alert("لم يتم العثور على العنوان، حاول مرة أخرى");
                        return;
                    }

                    const components = place.address_components;

                    document.getElementById(fieldIds.fullAddress).value = place.formatted_address;
                    document.getElementById(fieldIds.lat).value        = place.geometry.location.lat();
                    document.getElementById(fieldIds.lng).value        = place.geometry.location.lng();
                    document.getElementById(fieldIds.city).value       = getAddressComponent(components, "locality") ||
                                                                          getAddressComponent(components, "administrative_area_level_1");
                    document.getElementById(fieldIds.street).value     = getAddressComponent(components, "route");
                    document.getElementById(fieldIds.district).value   = getAddressComponent(components, "sublocality") ||
                                                                          getAddressComponent(components, "neighborhood");

                    input.value = place.formatted_address;
                });
            }

            // ========== DETECT CURRENT LOCATION BUTTON ==========
            function detectCurrentLocation(inputId, fieldIds) {
                if (!navigator.geolocation) {
                    alert("المتصفح لا يدعم تحديد الموقع");
                    return;
                }

                navigator.geolocation.getCurrentPosition((position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    const geocoder = new google.maps.Geocoder();
                    geocoder.geocode({ location: { lat, lng } }, (results, status) => {
                        if (status === "OK" && results[0]) {
                            const place = results[0];
                            const components = place.address_components;

                            document.getElementById(inputId).value                  = place.formatted_address;
                            document.getElementById(fieldIds.fullAddress).value     = place.formatted_address;
                            document.getElementById(fieldIds.lat).value             = lat;
                            document.getElementById(fieldIds.lng).value             = lng;
                            document.getElementById(fieldIds.city).value            = getAddressComponent(components, "locality");
                            document.getElementById(fieldIds.street).value          = getAddressComponent(components, "route");
                            document.getElementById(fieldIds.district).value        = getAddressComponent(components, "sublocality");
                        } else {
                            alert("تعذر تحديد العنوان");
                        }
                    });
                });
            }

            // ========== INIT BOTH INPUTS ==========
            setupAutocomplete("pickup-input", {
                fullAddress : "pickup-fulladdress",
                lat         : "pickup-lat",
                lng         : "pickup-lng"
            });

            setupAutocomplete("delivery-input", {
                fullAddress : "delivery-fulladdress",
                lat         : "delivery-lat",
                lng         : "delivery-lng"
            });

            // ========== DETECT LOCATION BUTTONS ==========
            document.getElementById("btn-detect-pickup").addEventListener("click", () => {
                detectCurrentLocation("pickup-input", {
                    fullAddress : "pickup-fulladdress",
                    lat         : "pickup-lat",
                    lng         : "pickup-lng"
                });
            });

            document.getElementById("btn-detect-delivery").addEventListener("click", () => {
                detectCurrentLocation("delivery-input", {
                    fullAddress : "delivery-fulladdress",
                    lat         : "delivery-lat",
                    lng         : "delivery-lng"
                });
            });
        }
    </script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.ApiKey&libraries=places&callback=initMap">
    </script>
    <script src="https://kit.fontawesome.com/5e0bf04421.js" crossorigin="anonymous"></script>
}