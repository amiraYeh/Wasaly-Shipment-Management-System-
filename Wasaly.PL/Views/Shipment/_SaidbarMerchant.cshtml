@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<div>
    <a asp-controller="Shipment" asp-action="MerchantDashboard"
           class="sidebar-item @(action == "MerchantDashboard" ? "active" : "")">
        <i class="bi bi-house-fill fs-5"></i> الرئيسية
    </a>

    <a asp-controller="Shipment" asp-action="Index"
           class="sidebar-item @(action == "Index" ? "active" : "")">
        <i class="bi bi-box-seam-fill fs-5"></i> شحناتي
    </a>

    <a asp-controller="Shipment" asp-action="Add"
           class="sidebar-item @(action == "Add" ? "active" : "")">
        <i class="bi bi-plus-circle-fill fs-5"></i> شحنة جديدة
    </a>

    @* <a asp-controller="Merchant" asp-action="Wallet"
           class="sidebar-item @(action == "Wallet" ? "active" : "")">
        <i class="bi bi-wallet2-fill fs-5"></i> محفظتي
    </a> *@
</div>

<div class="p-3 border-top border-white-10 mt-auto">
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/"
          method="post">
        <button type="submit" class="btn btn-outline-danger w-100 border-0 text-white"
                style="background: rgba(231, 76, 60, 0.1);">
            تسجيل الخروج
        </button>
    </form>
</div>
