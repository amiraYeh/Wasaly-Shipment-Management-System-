                        "primary-container": "#ff6b35",
                        "tertiary-container": "#00b15c",
                        "on-secondary-fixed-variant": "#45455b",
                        "surface": "#f9f9f9",
                        "surface-container-low": "#f3f3f3",
                        "on-background": "#1a1c1c",
                        "on-surface-variant": "#594139",
                        "tertiary-fixed-dim": "#4ae183",
                        "outline": "#8d7168",
                        "inverse-surface": "#2f3131",
                        "inverse-on-surface": "#f1f1f1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "12px",
                        "xl": "16px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xl": "32px",
                        "gutter": "20px",
                        "lg": "24px",
                        "base": "8px",
                        "margin": "24px",
                        "sm": "12px",
                        "xs": "4px",
                        "md": "16px"
                    },
                    "fontFamily": {
                        "number-display": ["Cairo"],
                        "h2": ["Cairo"],
                        "h1": ["Cairo"],
                        "h3": ["Cairo"],
                        "display": ["Cairo"],
                        "body-md": ["Cairo"],
                        "body-sm": ["Cairo"],
                        "body-lg": ["Cairo"],
