@page
@model CorierRoleRegisterationModel
@{
    Layout = null;
    ViewData["Title"] = "Complete Your Courier Profile";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/courier-register.css.css" />

<div class="page">

    <div class="card">

        <!-- HEADER -->
        <div class="header">
            <h2>إكمال بيانات المندوب </h2>
            <p>ارفع المستندات المطلوبة لإكمال التسجيل</p>
        </div>

        <!-- STEPPER -->
        <div class="stepper">
            <div class="step active">
                <span>1</span>
                البيانات
            </div>

            <div class="line"></div>

            <div class="step">
                <span>2</span>
                المستندات
            </div>
        </div>

        <!-- FORM -->
        <form method="post" enctype="multipart/form-data">

            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- National ID -->
            <label>صورة البطاقة</label>
            <div class="input-group">
                <input type="file" asp-for="Courier.NationalIdImage" accept="image/*" />
                <i class="fa fa-id-card"></i>
            </div>
            <span asp-validation-for="Courier.NationalIdImage" class="text-danger"></span>

            <!-- Driving License -->
            <label>رخصة القيادة</label>
            <div class="input-group">
                <input type="file" asp-for="Courier.DrivingLicenseImage" accept="image/*" />
                <i class="fa fa-car"></i>
            </div>
            <span asp-validation-for="Courier.DrivingLicenseImage" class="text-danger"></span>

            <!-- Profile Image -->
            <label>الصورة الشخصية</label>
            <div class="input-group">
                <input type="file" asp-for="Courier.ProfileImage" accept="image/*" />
                <i class="fa fa-user"></i>
            </div>
            <span asp-validation-for="Courier.ProfileImage" class="text-danger"></span>

            <!-- SUBMIT -->
            <button type="submit">إكمال التسجيل ←</button>

        </form>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}