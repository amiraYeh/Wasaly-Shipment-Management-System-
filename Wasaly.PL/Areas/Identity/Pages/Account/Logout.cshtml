@page
@model LogoutModel
@using Wasaly.DAL.Models
@inject SignInManager<WasalyIdentityUser> SignInManager
@inject UserManager<WasalyIdentityUser> UserManager
@{
    Layout = null;
    ViewData["Title"] = "Log out";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الخروج - Wasaly</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/StyleSheet.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="page">
        <div class="card">

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <!-- حالة: المستخدم لسه logged in → اسأله هل متأكد -->
                <div class="logout-icon warn">
                    <i class="fa fa-right-from-bracket"></i>
                </div>
                <div class="header">
                    <h2>تسجيل الخروج</h2>
                    <p>هل أنت متأكد من أنك تريد تسجيل الخروج من حسابك؟</p>
                </div>

                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit">تسجيل الخروج</button>
                </form>

                <a asp-page="/Index" class="btn-cancel">إلغاء والعودة</a>
            }
            else
            {
                <!-- حالة: تم تسجيل الخروج بالفعل -->
                <div class="logout-icon success">
                    <i class="fa fa-circle-check"></i>
                </div>
                <div class="header">
                    <h2>تم تسجيل الخروج</h2>
                    <p>لقد خرجت من حسابك بنجاح. نراك قريباً!</p>
                </div>

                <a asp-page="/Index" class="btn-home">العودة للرئيسية</a>
            }

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
