@page
@model RegisterModel
@using Wasaly.DAL.Models
@inject SignInManager<WasalyIdentityUser> SignInManager
@inject UserManager<WasalyIdentityUser> UserManager

@{
    Layout = null;
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إنشاء حساب - Wasaly</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/StyleSheet.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="page">
        <div class="card">
            <div class="header">
                <h2>إنشاء حساب</h2>
                <p>املأ البيانات لإنشاء حساب جديد</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <input type="hidden" asp-for="RoleFromHome" />

                <label>البريد الإلكتروني</label>
                <div class="input-group">
                    <input asp-for="Input.Email" />
                    <i class="fa fa-envelope"></i>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <label>الاسم الكامل</label>
                <div class="input-group">
                    <input asp-for="Input.FullName" />
                    <i class="fa fa-user"></i>
                </div>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>

                <label>العنوان</label>
                <div class="input-group">
                    <input asp-for="Input.Address" />
                    <i class="fa fa-location-dot"></i>
                </div>
                <span asp-validation-for="Input.Address" class="text-danger"></span>

                <label>رقم الهاتف</label>
                <div class="input-group phone">
                    <span class="prefix">+20</span>
                    <input asp-for="Input.PhoneNumber" />
                    <i class="fa fa-phone"></i>
                </div>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>

                <label>العمر</label>
                <div class="input-group">
                    <input asp-for="Input.Age" type="number" />
                    <i class="fa fa-calendar"></i>
                </div>
                <span asp-validation-for="Input.Age" class="text-danger"></span>

                <label>النوع</label>
                <div class="input-group">
                    <select asp-for="Input.Gender">
                        <option value="">اختار الجنس</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <i class="fa fa-venus-mars"></i>
                </div>
                <span asp-validation-for="Input.Gender" class="text-danger"></span>

                <label>المركز</label>
                <div class="input-group">
                    <select asp-for="Input.Region" asp-items="Model.Regions">
                        <option value="">اختار المركز</option>
                    </select>
                    <i class="fa fa-map"></i>
                </div>
                <span asp-validation-for="Input.Region" class="text-danger"></span>

                <label>كلمة المرور</label>
                <div class="input-group">
                    <input asp-for="Input.Password" type="password" />
                    <i class="fa fa-lock"></i>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <label>تأكيد كلمة المرور</label>
                <div class="input-group success">
                    <input asp-for="Input.ConfirmPassword" type="password" />
                    <i class="fa fa-lock"></i>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                <button type="submit">التالى ←</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}