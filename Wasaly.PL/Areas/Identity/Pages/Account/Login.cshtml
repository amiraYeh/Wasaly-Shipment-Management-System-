@page
@using Wasaly.DAL.Models
@model LoginModel
@inject SignInManager<WasalyIdentityUser> SignInManager
@inject UserManager<WasalyIdentityUser> UserManager
@{
    Layout = null;
    ViewData["Title"] = "Log in";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - Wasaly</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/StyleSheet.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="page">
    <div class="card">

        <!-- Header -->
        <div class="header">
            <h2>تسجيل الدخول</h2>
            <p>أدخل بياناتك للوصول إلى حسابك</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <!-- EMAIL -->
            <label>البريد الإلكتروني</label>
            <div class="input-group">
                <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="example@mail.com" />
                <i class="fa fa-envelope"></i>
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <!-- PASSWORD -->
            <label>كلمة المرور</label>
            <div class="input-group">
                <input asp-for="Input.Password" type="password" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <i class="fa fa-lock"></i>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>


            <!-- SUBMIT -->
            <button id="login-submit" type="submit">تسجيل الدخول ←</button>
        </form>

      

        <!-- EXTERNAL LOGIN -->
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="divider">أو سجل عن طريق</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="ext-btn" name="provider" value="@provider.Name" title="@provider.DisplayName">
                        @provider.DisplayName
                    </button>
                }
            </form>
        }

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
