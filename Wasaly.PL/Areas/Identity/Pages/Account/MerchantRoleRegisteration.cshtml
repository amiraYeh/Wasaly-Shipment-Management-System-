@page
@model Wasaly.PL.Areas.Identity.Pages.Account.MerchantRoleRegisterationModel
@{
    Layout = null;
    ViewData["Title"] = "Complete Your Merchant Profile";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/merchant-register.css" />

<div class="page">

    <div class="card">

        <!-- HEADER -->
        <div class="header">
            <h2>إكمال بيانات التاجر</h2>
            <p>أدخل بيانات المتجر لإكمال التسجيل</p>
        </div>

        <!-- STEPPER -->
        <div class="stepper">
            <div class="step active">
                <span>1</span>
                البيانات
            </div>

            <div class="line"></div>

            <div class="step">
                <span>2</span>
                المتجر
            </div>
        </div>

        <form method="post">

            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- STORE NAME -->
            <label>اسم المتجر</label>
            <div class="input-group">
                <input asp-for="Merchant.StoreName" placeholder="أدخل اسم المتجر" />
                <i class="fa fa-store"></i>
            </div>
            <span asp-validation-for="Merchant.StoreName" class="text-danger"></span>

            <!-- BUSINESS TYPE -->
            <label>نوع النشاط</label>
            <div class="input-group">
                <input asp-for="Merchant.BusinessType" placeholder="مثال: مطعم - سوبر ماركت - صيدلية" />
                <i class="fa fa-briefcase"></i>
            </div>
            <span asp-validation-for="Merchant.BusinessType" class="text-danger"></span>

            <!-- SUBMIT -->
            <button type="submit">إكمال التسجيل ←</button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}